APP_ENV=development
APP_NAME=Verbaia API
CORS_ORIGINS=http://localhost:3000
OWNER_BOOTSTRAP_TOKEN=change-this-before-deploying
AI_PROVIDER=external
AI_API_BASE_URL=
AI_API_KEY=
MEDIA_IMPORT_ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com
